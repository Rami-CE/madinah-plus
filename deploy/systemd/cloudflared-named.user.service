[Unit]
Description=Cloudflare Tunnel (named) for MadinahPlus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/meow/.cloudflared/config.yml --no-autoupdate run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
